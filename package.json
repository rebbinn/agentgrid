{
  "name": "agentgrid",
  "version": "2.3.0",
  "description": "Multiple AI agent terminals. One workspace.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:ssh": "go -C native/ssh-helper build -trimpath -ldflags=\"-s -w\" -o ../../resources/bin/agentgrid-ssh.exe .",
    "test:ssh": "go -C native/ssh-helper test ./...",
    "dist": "npm run build:ssh && npm run build && electron-builder --win",
    "dist:dir": "npm run build:ssh && npm run build && electron-builder --win --dir",
    "icon": "node scripts/build-icon.cjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "author": {
    "name": "rebbinn",
    "email": "183514460+rebbinn@users.noreply.github.com"
  },
  "homepage": "https://agentgrid.local"
}
